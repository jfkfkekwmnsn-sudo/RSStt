# Application
APP_NAME=News Aggregator
DEBUG=true
SECRET_KEY=your-secret-key-min-32-characters-long

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_aggregator

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_MODERATION_CHAT_ID=0

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true
AI_MAX_TOKENS_PER_DAY=100000

# Ingestion
DEFAULT_FETCH_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_FETCH=50
ARTICLE_FRESHNESS_DAYS=7

# Publishing
MIN_PUBLISH_INTERVAL_SECONDS=60
MAX_PUBLISH_RETRIES=3